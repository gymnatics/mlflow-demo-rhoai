################################################################################
# Project Configuration -- RAG Governance POC
################################################################################
# Edit this file to re-skin the POC for a new client or deployment.
# All scripts, manifests, and defaults draw from these values.
################################################################################

# --- Project identity ---
PROJECT_PREFIX=gov
NAMESPACE=${PROJECT_PREFIX}-rag-poc
RAG_APP_NAME=${PROJECT_PREFIX}-rag-app
AUDIT_PORTAL_NAME=${PROJECT_PREFIX}-audit-portal
SERVICE_ACCOUNT=${PROJECT_PREFIX}-poc-agent
SECRET_NAME=${PROJECT_PREFIX}-poc-secrets
CONFIGMAP_NAME=${PROJECT_PREFIX}-poc-config

# --- MLflow ---
MLFLOW_EXPERIMENT_NAME=rag-governance-poc
PIPELINE_NAME=rag-evaluation
PIPELINE_YAML=eval-pipeline.yaml

# --- Cluster-specific (set per deployment) ---
CLUSTER_DOMAIN=apps.cluster.example.com
LLM_MODEL=qwen35-9b-awq

# --- Application branding ---
APP_TITLE="Policy Compliance Assistant"
PORTAL_TITLE="Governance Audit Portal"
